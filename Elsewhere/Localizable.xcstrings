    "%@ · 在地图上点一下或搜索，选新的位置" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Click the map or search to pick a new spot"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 在地图上点一下或搜索，选新的位置"
