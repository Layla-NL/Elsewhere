    "%@ 暂时无法%@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 暂时无法%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can't %@ right now"
          }
        }
      }
    },
    "%@ 未连接" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ not connected"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未连接"
          }
        }
      }
    },
    "%@ 的时区（%@）与定位不一致。在「设置」>「通用」>「日期与时间」中关闭「自动设定时区」，然后选择同一时区的城市。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 的时区（%2$@）与定位不一致。在「设置」>「通用」>「日期与时间」中关闭「自动设定时区」，然后选择同一时区的城市。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@'s time zone (%@) doesn't match its location. In Settings > General > Date & Time, turn off Set Automatically, then pick a city in the same time zone."
          }
        }
      }
    },
    "%@ 的时区（%@）与定位不一致。在「设置」>「通用」>「日期与时间」中打开「自动设定时区」。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 的时区（%2$@）与定位不一致。在「设置」>「通用」>「日期与时间」中打开「自动设定时区」。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@'s time zone (%@) doesn't match its location. In Settings > General > Date & Time, turn on Set Automatically."
          }
        }
      }
    },
